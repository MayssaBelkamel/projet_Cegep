<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Atlas du Monde</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/_4D5_tp2_Mayssa_Belkamel.styles.css" asp-append-version="true" />
</head>

<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container">

                <!-- Logo / Titre -->
                <a class="navbar-brand fw-bold" asp-area="" asp-page="/Index">
                    🌍 Atlas du Monde
                </a>

                <!-- Bouton mobile -->
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
                        aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <!-- Menu principal -->
                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav me-auto">

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Pays" asp-action="Index">Tous les pays</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Pays" asp-action="IndexVue">Infos sur les pays</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Pays" asp-action="FiltreResultat">Filtrer les pays</a>
                        </li>

                    </ul>

                    <!-- Zone droite : Connexion / Déconnexion -->
                    <ul class="navbar-nav">

                        @if (User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item">
                                <a class="nav-link text-danger fw-semibold" asp-controller="Clients" asp-action="Deconnexion">
                                    Déconnexion
                                </a>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link fw-semibold" asp-controller="Clients" asp-action="Connexion">
                                    Connexion
                                </a>
                            </li>
                        }

                    </ul>
                </div>

            </div>
        </nav>
    </header>

    <!-- Contenu principal -->
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <!-- Pied de page -->
    <footer class="border-top footer text-muted mt-4">
        <div class="container text-center py-3">
            &copy; 2026 - Atlas du Monde -
            <a asp-area="" asp-page="/Privacy">Confidentialité</a>
        </div>
    </footer>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
