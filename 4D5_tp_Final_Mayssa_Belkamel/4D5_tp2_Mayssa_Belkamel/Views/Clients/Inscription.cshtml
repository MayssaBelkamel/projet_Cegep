@model _4D5_tp2_Mayssa_Belkamel.ViewModel.IncriptionViewModel

<div class="container mt-4">

    <a asp-action="Index" class="text-decoration-none mb-3 d-inline-block">
        ← Retour à l'index
    </a>

    <h1 class="text-center fw-bold mb-4">📝 Inscription</h1>

    <div class="pays-background p-4 rounded shadow-sm mx-auto" style="max-width: 500px;">

        <form asp-action="Inscription">

            <div asp-validation-summary="All" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="Nom" class="form-label fw-semibold"></label>
                <input asp-for="Nom" class="form-control" />
                <span asp-validation-for="Nom" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Prenom" class="form-label fw-semibold"></label>
                <input asp-for="Prenom" class="form-control" />
                <span asp-validation-for="Prenom" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Courriel" class="form-label fw-semibold"></label>
                <input asp-for="Courriel" class="form-control" />
                <span asp-validation-for="Courriel" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="MotDePasse" class="form-label fw-semibold"></label>
                <input asp-for="MotDePasse" class="form-control" type="password" />
                <span asp-validation-for="MotDePasse" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="MotDePasseConfirmation" class="form-label fw-semibold"></label>
                <input asp-for="MotDePasseConfirmation" class="form-control" type="password" />
                <span asp-validation-for="MotDePasseConfirmation" class="text-danger"></span>
            </div>

            <button type="submit" class="btn-atlas w-100 mt-3">
                S'inscrire
            </button>

        </form>

    </div>

</div>

@section Scripts {
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
}
