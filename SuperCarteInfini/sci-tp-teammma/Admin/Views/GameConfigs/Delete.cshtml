@model Models.Models.GameConfig

@{
    ViewData["Title"] = "Delete";
}

<h1>Supprimer</h1>

<h3>Êtes-vous certain de vouloir supprimer cette configuration?</h3>
<div>
    <h4>Configuration</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.NbDrawedCard)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.NbDrawedCard)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.ReceivedMana)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.ReceivedMana)
        </dd>
    </dl>
    
    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Supprimer" class="btn btn-danger" /> |
        <a asp-action="Index">Retourner à la liste</a>
    </form>
</div>
